# Copy values into your shell environment or a local .env file.
# npm start固定production模式，npm run dev固定development模式；显式冲突会报错。
# 不使用NODE_ENV判断数据归属。
# MULTIVAC_MODE=development
# API默认生产4317、开发4318；开发Vite5173同步代理到实际API端口。
# MULTIVAC_PORT=4418
# 服务配置默认关闭外部访问；根目录npm run dev默认显式启用。
# 启用且未配置token时自动生成，启动终端打印，保存到数据目录后复用。
# 默认支持局域网、Tailscale IP/域名等入口，各地址登录时仍校验同源。
# 可选手动token须为32至4096字节；手动值优先，不在启动终端打印。
# 不要把真实token提交到仓库；轮换/关闭时更新环境或保存文件并停止、重启服务。
# MULTIVAC_REMOTE_ENABLED=1
# MULTIVAC_REMOTE_TOKEN=<private-random-token>
# 可选：限制为单一访问地址；需要局域网与Tailscale同时使用时留空或不设置。
# MULTIVAC_REMOTE_ORIGIN=https://multivac.example.com
# MULTIVAC_REMOTE_HOST=0.0.0.0
# 数据目录默认生产~/.multivac、开发~/.multivac-dev；开发不会复制或借用生产/Pi全局配置。
# MULTIVAC_DATA_DIR=/absolute/path/to/multivac-data
# 工作根默认生产~/Multivac、开发~/Multivac-dev；须为绝对路径，且与数据目录互不包含。
# MULTIVAC_WORK_ROOT=/absolute/path/to/Multivac
# 到期的会话临时目录移入的废纸篓目录，默认系统废纸篓（macOS ~/.Trash，Linux 等按 XDG 规范）；须为绝对路径。
# MULTIVAC_TRASH_DIR=/absolute/path/to/trash
# 目录外访问等待授权的时限（毫秒），默认 30 分钟；超时后请求过期，本轮结束。
# MULTIVAC_TOOL_AUTHORIZATION_TIMEOUT_MS=1800000
MULTIVAC_PROVIDER=openai
MULTIVAC_MODEL=gpt-4.1-mini
# 模型环境变量是显式配置；两个实例如需不同认证，应在各自启动环境分别设置。
# 开发页面管理的Pi认证保存在开发数据目录/pi/auth.json。
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# MULTIVAC_API=openai-responses
# MULTIVAC_THINKING=medium
# MULTIVAC_MODELS_FILE=./models.json
# LOCAL_MODEL_API_KEY=local-placeholder

# Real Pi smoke tests are disabled by default. Enable only with valid model authentication.
# MULTIVAC_PI_SMOKE=1

# 网页搜索与读取：显式启用，与会话模型独立；密钥仅保留在本实例服务端环境。
# MULTIVAC_WEB_PROVIDER=deepseek
# MULTIVAC_WEB_API_KEY=<deepseek-api-key>
