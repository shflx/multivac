{
  "name": "@multivac/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/patch-pi-responses.mjs --check && node ../../scripts/patch-terminals.mjs --check",
    "prebuild": "node ../../scripts/patch-pi-responses.mjs --check && node ../../scripts/patch-terminals.mjs --check",
    "precheck": "node ../../scripts/patch-pi-responses.mjs --check && node ../../scripts/patch-terminals.mjs --check",
    "pretest": "node ../../scripts/patch-pi-responses.mjs --check && node ../../scripts/patch-terminals.mjs --check",
    "prestart": "node ../../scripts/patch-pi-responses.mjs --check && node ../../scripts/patch-terminals.mjs --check",
    "dev": "tsx src/main.ts --mode=development",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:coordinator": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:pi-smoke": "MULTIVAC_PI_SMOKE=1 tsx --test tests/pi-coordinator-smoke.test.ts",
    "start": "node dist/main.js --mode=production"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@multivac/contracts": "0.1.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "mdast-util-from-markdown": "2.0.3",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "typebox": "1.3.7",
    "ws": "8.21.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
