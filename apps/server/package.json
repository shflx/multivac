{
  "name": "@multivac/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:coordinator": "tsx --test tests/*.test.ts",
    "test:pi-smoke": "MULTIVAC_PI_SMOKE=1 tsx --test tests/pi-coordinator-smoke.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@multivac/contracts": "0.1.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "mdast-util-from-markdown": "2.0.3",
    "pdfjs-dist": "6.4.299",
    "typebox": "1.3.7",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/yauzl": "3.4.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
